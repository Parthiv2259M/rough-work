generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id              String    @id @default(cuid())
  userId          String
  hotelId         String
  checkIn         DateTime
  checkOut        DateTime
  guests          Int
  roomType        String
  nights          Int
  basePrice       Int
  serviceFee      Int
  tax             Int
  discount        Int
  totalPrice      Int
  promoCode       String?
  paymentStatus   String    @default("pending")
  paymentMethod   String    @default("card")
  stripeSessionId String?   @unique
  stripePaymentId String?   @unique
  guestName       String?
  guestEmail      String?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hotelId])
  @@index([stripeSessionId])
}

model PaymentLog {
  id              String    @id @default(cuid())
  bookingId       String
  stripeEventId   String    @unique
  eventType       String
  status          String
  amount          Int
  currency        String
  description     String?
  createdAt       DateTime  @default(now())

  @@index([bookingId])
}
