CLOUD_COST_PER_HOUR=0.04

# ============================================================
# URI ENGINE CONFIGURATION
# ============================================================
# Trigger mode: "uri" (Unified Risk Index) | "threshold" (legacy temp-only)
TRIGGER_MODE=uri

# URI decision threshold [0, 1] — offload when URI >= this value
URI_THRESHOLD=0.50

# --- Hardware Depreciation (Arrhenius + Coffin-Manson) ---
E_A=0.7
T_REF=318.15
T_CRIT=358.15
COFFIN_MANSON_N=2.0
COFFIN_MANSON_C=10000.0
L0=50000.0
F_CYC=1.0
W1=0.6
W2=0.4
K_D=8.0
D_MID=0.3

# --- Cloud Risk (Real AWS Signals & Volatility) ---
AWS_REGION=us-east-1
SPOT_INSTANCE_TYPES=t2.micro,t3.micro
PRICE_FETCH_INTERVAL_TICKS=5
ZSCORE_WINDOW_W=5
BOLLINGER_NUM_STD=2.0
PLACEMENT_SCORE_CACHE_TTL=60.0
ETA=0.1
MU1=0.4
MU2=0.3
MU3=0.3
K_R=10.0
R_MID=0.15
C_PENALTY=0.10
C_MIGRATE=0.05
L_REEXEC=0.08
LAMBDA_COST=1.0
P_REF=0.04
C_REF=0.25
