# --- Queue Urgency ---
NU1=0.4
NU2=0.35
NU3=0.25
Q_MAX=10.0
C_MAX=10.0
EPSILON=15.0

# --- Dynamic Weights (Simplex) ---
ALPHA0=0.33
ALPHA_MAX=0.70
BETA0=0.33
BETA_MAX=0.50
P_EXP=2.0
KAPPA=2.0
